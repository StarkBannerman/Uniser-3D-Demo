/**
 * Turn the asset licence files into the credits the app shows.
 *
 * Twenty-seven of the thirty-two assets in `render/models` are licensed
 * CC-BY, which requires the author to be credited "wherever you share it".
 * The demo shares them — the rooms are path-traced from this geometry and
 * deployed publicly — so the credit is an obligation rather than a
 * courtesy, and it was missing until this existed.
 *
 * Generated rather than hand-written, because a hand-written list is a
 * second copy of the truth and goes stale the first time an asset is
 * swapped. `render/models/<room>/<asset>/license.txt` is the record that
 * ships with the asset; this parses it and writes `lib/credits.ts`.
 *
 *     npx tsx scripts/build-credits.mts
 *
 * Re-run it after adding, removing or replacing any model.
 *
 * The three NonCommercial assets are credited like any other CC-BY work,
 * because their licences require it too. They are also flagged in the
 * output, which is not about the page: `NON_COMMERCIAL_ROOMS` is there so
 * that whoever decides whether this demo may be sold can see at a glance
 * which rooms still contain work licensed against commercial use.
 */

import { readFileSync, writeFileSync, readdirSync, existsSync, statSync } from "node:fs";
import { join } from "node:path";

const MODELS = "render/models";
const OUT = "lib/credits.ts";

interface Parsed {
  path: string;
  room: string;
  title: string;
  author: string;
  authorUrl: string;
  source: string;
  licence: string;
  licenceUrl: string;
}

/** `* author:\tName (https://...)` -> the value, tabs and spaces collapsed. */
function field(text: string, key: string): string {
  const m = text.match(new RegExp(`^\\* ${key}:[ \\t]*(.+)$`, "m"));
  return m ? m[1].trim() : "";
}

/** `Name (https://url)` -> `["Name", "https://url"]`. */
function splitUrl(value: string): [string, string] {
  const m = value.match(/^(.*?)\s*\((https?:\/\/[^)]+)\)\s*$/);
  return m ? [m[1].trim(), m[2]] : [value, ""];
}

const found: Parsed[] = [];
for (const room of readdirSync(MODELS).sort()) {
  const roomDir = join(MODELS, room);
  if (!statSync(roomDir).isDirectory()) continue;
  for (const asset of readdirSync(roomDir).sort()) {
    const file = join(roomDir, asset, "license.txt");
    if (!existsSync(file)) continue;
    const text = readFileSync(file, "utf8");
    const [author, authorUrl] = splitUrl(field(text, "author"));
    const [licence, licenceUrl] = splitUrl(field(text, "license type"));
    found.push({
      path: `${room}/${asset}`,
      room,
      title: field(text, "title"),
      author,
      authorUrl,
      source: field(text, "source"),
      licence,
      licenceUrl,
    });
  }
}

/**
 * Which assets the page lists, and under which heading.
 *
 * `required` is the legal test and nothing else: CC-BY and its
 * NonCommercial variants all say the author must be credited. CC0, the
 * Unsplash Licence and the Sketchfab Standard licence do not, so those are
 * listed as a courtesy and said to be one.
 *
 * An asset with no `license.txt`, or one whose licence is recorded as
 * unconfirmed, is left out rather than guessed at. Crediting something
 * under a licence nobody has read would be inventing the licence, which
 * is worse than the silence.
 */
const unconfirmed = found.filter((c) => /NOT YET CONFIRMED/i.test(c.licence));
const listed = found.filter((c) => !/NOT YET CONFIRMED/i.test(c.licence));
const required = (c: Parsed) => /^CC-BY/i.test(c.licence);
const nonCommercial = (c: Parsed) => /-NC/i.test(c.licence);

const rows = listed
  .map((c) => ({ ...c, required: required(c), nonCommercial: nonCommercial(c) }))
  .sort((a, b) =>
    Number(b.required) - Number(a.required) ||
    a.author.toLowerCase().localeCompare(b.author.toLowerCase()),
  );

const body = `// Generated by scripts/build-credits.mts — do not edit by hand.
// Source of truth: render/models/<room>/<asset>/license.txt
//
// Re-run \`npx tsx scripts/build-credits.mts\` after any asset changes.
${unconfirmed.length ? `//\n// Excluded, licence unconfirmed: ${unconfirmed.map((c) => c.path).join(", ")}\n` : ""}
export interface Credit {
  /** "lobby/plant_2" — where the asset lives under render/models. */
  path: string;
  /** The room that uses it. */
  room: string;
  title: string;
  author: string;
  authorUrl: string;
  /** The asset's own page. */
  source: string;
  licence: string;
  licenceUrl: string;
  /** True when the licence obliges us to credit, rather than inviting it. */
  required: boolean;
  /** True for a licence that forbids commercial use. Pending replacement. */
  nonCommercial: boolean;
}

export const CREDITS: Credit[] = ${JSON.stringify(rows, null, 2)};

/** Rooms that still contain an asset licensed for non-commercial use only. */
export const NON_COMMERCIAL_ROOMS: string[] = ${JSON.stringify(
  [...new Set(rows.filter((r) => r.nonCommercial).map((r) => r.room))].sort(),
)};
`;

writeFileSync(OUT, body);
console.log(`${OUT}: ${rows.length} credits (${rows.filter(required).length} required)`);
if (unconfirmed.length) {
  console.log(`  excluded, licence unconfirmed: ${unconfirmed.map((c) => c.path).join(", ")}`);
}
const nc = rows.filter((r) => r.nonCommercial);
if (nc.length) {
  console.log(`  non-commercial, so not licensed for a demo that is sold: ${nc.map((c) => c.path).join(", ")}`);
}
